# Optional: copy to .env to override the local defaults. No .env is required.
NOFRILLZ_HTTP_BIND=127.0.0.1
NOFRILLZ_API_PORT=3100
NOFRILLZ_PORTAL_PORT=3101
NOFRILLZ_PUBLIC_API_URL=http://localhost:3100
NOFRILLZ_MYSQL_PORT=3308
NOFRILLZ_REDIS_PORT=6381
NOFRILLZ_MYSQL_DATABASE=nofrillz
NOFRILLZ_MYSQL_USER=nofrillz
NOFRILLZ_MYSQL_PASSWORD=dev-password
NOFRILLZ_MYSQL_ROOT_PASSWORD=dev-root-password
NOFRILLZ_SESSION_JWT_SECRET=local-dev-change-me
NOFRILLZ_ADMIN_API_KEY=dev-admin-key
NOFRILLZ_LOG_LEVEL=info

# Independent Snowflake nodes for processes writing to the same database.
NOFRILLZ_ID_GENERATOR_REGION=0
NOFRILLZ_API_ID_GENERATOR_NODE=0
NOFRILLZ_AI_POSTER_ID_GENERATOR_NODE=1
NOFRILLZ_SEED_ID_GENERATOR_NODE=2
NOFRILLZ_SEED_USER_COUNT=25

# Mock generation works locally without credentials or paid API calls.
NOFRILLZ_AI_TOOLS_PROVIDER=mock
NOFRILLZ_AI_POSTER_POLL_INTERVAL_SECONDS=60
NOFRILLZ_AI_POSTER_BATCH_SIZE=10
NOFRILLZ_AI_POSTER_STALE_RUNNING_AFTER_MINUTES=15
NOFRILLZ_AI_TOOLS_OPENAI_API_KEY=
NOFRILLZ_AI_TOOLS_OPENAI_ACCOUNT_ID=
NOFRILLZ_AI_TOOLS_OPENAI_ORGANIZATION_ID=
NOFRILLZ_AI_TOOLS_OPENAI_PROJECT_ID=
NOFRILLZ_AI_TOOLS_OPENAI_BASE_URL=https://api.openai.com/v1
NOFRILLZ_AI_TOOLS_OPENAI_MODEL=gpt-4.1
NOFRILLZ_AI_TOOLS_OPENAI_TIMEOUT_SECONDS=30

# Optional iOS push delivery; disabled for local development.
NOFRILLZ_APNS_ENABLED=false
NOFRILLZ_APNS_TOPIC=
NOFRILLZ_APNS_ENVIRONMENT=sandbox
NOFRILLZ_APNS_AUTH_KEY_BASE64=
NOFRILLZ_APNS_KEY_ID=
NOFRILLZ_APNS_TEAM_ID=
NOFRILLZ_APNS_TIMEOUT_SECONDS=10
