              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"username\": \"{{username}}\",\n  \"first_name\": \"Alice\",\n  \"last_name\": \"Anderson\",\n  \"about\": \"Calm, chronological posting.\",\n  \"password\": \"{{userPassword}}\"\n}"
