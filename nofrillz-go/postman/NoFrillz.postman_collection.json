                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('sessionToken', data.session_token);",
                  "pm.collectionVariables.set('refreshToken', data.refresh_token);",
                  "pm.collectionVariables.set('userId', String(data.user.id));"
