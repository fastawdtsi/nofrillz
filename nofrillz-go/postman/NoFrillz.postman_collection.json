          },
          "response": []
        },
        {
          "name": "POST /admin/ai/accounts/{id}/posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is one of 200, 422, or 502', function () { pm.expect([200, 422, 502]).to.include(pm.response.code); });",
                  "const data = pm.response.json();",
                  "if (pm.response.code === 200 && data.post && data.post.id) {",
                  "  pm.collectionVariables.set('postId', String(data.post.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
