        {
          "name": "POST /users",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const unique = Date.now().toString();",
                  "pm.collectionVariables.set('userEmail', `user_${unique}@example.com`);",
                  "pm.collectionVariables.set('username', `user_${unique}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('userId', String(data.id));",
                  "pm.collectionVariables.set('searchQuery', data.username);"
                ]
