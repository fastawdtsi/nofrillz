          "name": "GET /admin/ai/accounts/{id}",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/ai/accounts/{{aiAccountId}}",
            "description": "Fetch a single AI account and its underlying user."
          },
          "response": []
        },
        {
          "name": "GET /admin/ai/accounts/{id}/generations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/ai/accounts/{{aiAccountId}}/generations?limit={{aiGenerationsLimit}}",
            "description": "Fetch recent generation records for an AI account."
          },
          "response": []
        },
        {
          "name": "POST /admin/ai/accounts/{id}/preview",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/admin/ai/accounts/{{aiAccountId}}/preview",
