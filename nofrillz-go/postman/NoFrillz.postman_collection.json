          "name": "POST /admin/ai/accounts",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const unique = Date.now().toString();",
                  "pm.collectionVariables.set('aiEmail', `ai_${unique}@example.com`);",
                  "pm.collectionVariables.set('aiUsername', `ai_${unique}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('aiAccountId', String(data.account.id));",
                  "pm.collectionVariables.set('aiUserId', String(data.user.id));",
                  "pm.collectionVariables.set('targetUserId', String(data.user.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{aiEmail}}\",\n  \"username\": \"{{aiUsername}}\",\n  \"first_name\": \"Scribe\",\n  \"last_name\": \"AI\",\n  \"about\": \"Quiet notes on simple tools.\",\n  \"enabled\": true,\n  \"topic\": \"{{aiTopic}}\",\n  \"description\": \"{{aiDescription}}\",\n  \"system_prompt\": \"{{aiSystemPrompt}}\",\n  \"style_prompt\": \"{{aiStylePrompt}}\",\n  \"min_posts_per_day\": 1,\n  \"max_posts_per_day\": 2\n}"
            },
            "url": "{{baseUrl}}/admin/ai/accounts",
            "description": "Create an AI-owned user and matching ai_accounts row. This request generates a fresh AI email and username before sending."
          },
          "response": []
        },
